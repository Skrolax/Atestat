      <console name="Connection" type="STANDARD" schema="main" session="Main"><![CDATA[DROP TABLE IF EXISTS "review";
DROP TABLE IF EXISTS "companyservices";
DROP TABLE IF EXISTS "services";
DROP TABLE IF EXISTS "company";
DROP TABLE IF EXISTS "user";

-- 1. User Table
CREATE TABLE "user" (
  "UserID" INTEGER PRIMARY KEY AUTOINCREMENT,
  "Name" VARCHAR(255) NOT NULL,
  "Email" VARCHAR(255) NOT NULL UNIQUE,
  "Password" BLOB NOT NULL,
  "Join_Date" DATE DEFAULT (date('now')),
  "Photo_Byte" BLOB
);

-- 2. Company Table (Added Address and Website)
CREATE TABLE "company" (
  "CompanyID" INTEGER PRIMARY KEY AUTOINCREMENT,
  "Name" VARCHAR(255) NOT NULL,
  "Business_Email" VARCHAR(255),
  "Customer_Service_Email" VARCHAR(255),
  "Business_Phone_Number" VARCHAR(50),
  "Customer_Service_Phone_Number" VARCHAR(50),
  "Address" VARCHAR(500),
  "Website_Link" VARCHAR(255),
  "Company_Founded_Date" DATE,
  "Photo_Byte" BLOB
);

-- 3. Services Table (Master list)
CREATE TABLE "services" (
  "ServiceID" INTEGER PRIMARY KEY AUTOINCREMENT,
  "Service" VARCHAR(255) NOT NULL UNIQUE
);

-- 4. CompanyServices (Junction Table)
-- Still needed so you can find companies based on what they offer!
CREATE TABLE "companyservices" (
  "CompanyServicesID" INTEGER PRIMARY KEY AUTOINCREMENT,
  "CompanyID" INTEGER NOT NULL,
  "ServiceID" INTEGER NOT NULL,
  UNIQUE ("CompanyID", "ServiceID"),
  FOREIGN KEY ("CompanyID") REFERENCES "company"("CompanyID") ON DELETE CASCADE,
  FOREIGN KEY ("ServiceID") REFERENCES "services"("ServiceID") ON DELETE CASCADE
);

-- 5. Review Table (Simplified: Points only to the Company)
CREATE TABLE "review" (
  "ReviewID" INTEGER PRIMARY KEY AUTOINCREMENT,
  "UserID" INTEGER NOT NULL,
  "CompanyID" INTEGER NOT NULL,
  "Review_Text" TEXT,
  "Rating" DECIMAL(2,1),
  "Is_Anonymous" INTEGER DEFAULT 0,
  "Review_DateTime" DATETIME DEFAULT CURRENT_TIMESTAMP,

  CONSTRAINT "chk_rating" CHECK ("Rating" >= 1.0 AND "Rating" <= 5.0),
  FOREIGN KEY ("UserID") REFERENCES "user"("UserID") ON DELETE CASCADE,
  FOREIGN KEY ("CompanyID") REFERENCES "company"("CompanyID") ON DELETE CASCADE
);

-- 1. Companies with their services
DROP VIEW IF EXISTS view_companies;
CREATE VIEW view_companies AS
SELECT
    c.CompanyID,
    c.Name AS Company_Name,
    GROUP_CONCAT(s.Service, ', ') AS Services_Offered, -- Fixed SQLite separator
    c.Address,
    c.Business_Email,
    c.Customer_Service_Email,
    c.Business_Phone_Number,
    c.Customer_Service_Phone_Number,
    c.Website_Link,
    c.Company_Founded_Date,
    c.Photo_Byte
FROM company c
LEFT JOIN companyservices cs ON c.CompanyID = cs.CompanyID
LEFT JOIN services s ON cs.ServiceID = s.ServiceID
GROUP BY c.CompanyID;

-- 2. Users
DROP VIEW IF EXISTS view_users;
CREATE VIEW view_users AS
SELECT UserID, Name, Email, Password, Join_Date, Photo_Byte FROM "user";

-- 3. All Reviews (Fixed column name to Review_DateTime)
DROP VIEW IF EXISTS view_all_reviews;
CREATE VIEW view_all_reviews AS
SELECT ReviewID, UserID, CompanyID, Review_Text, Rating, Is_Anonymous, Review_DateTime FROM review;

-- 4. All Services
DROP VIEW IF EXISTS view_all_services;
CREATE VIEW view_all_services AS
SELECT ServiceID, Service FROM services;

-- 5. Company Services link
DROP VIEW IF EXISTS view_companyservices;
CREATE VIEW view_companyservices AS
SELECT CompanyID, ServiceID FROM companyservices;

-- 6. Detailed Company Reviews
DROP VIEW IF EXISTS view_company_reviews;
CREATE VIEW view_company_reviews AS
SELECT
    r.ReviewID,
    r.CompanyID,
    c.Name AS Company_Name,
    r.UserID,
    u.Name AS User_Name,
    u.Photo_Byte AS User_Photo,
    r.Rating,
    r.Review_Text,
    r.Review_DateTime,
    r.Is_Anonymous
FROM review r
JOIN "user" u ON r.UserID = u.UserID
JOIN company c ON r.CompanyID = c.CompanyID;

-- 7. Detailed User Reviews
DROP VIEW IF EXISTS view_user_review;
CREATE VIEW view_user_review AS
SELECT
    r.ReviewID,
    u.UserID,
    u.Name AS User_Name,
    u.Photo_Byte AS User_Photo,
    c.CompanyID,
    c.Name AS Company_Name,
    r.Rating,
    r.Review_Text,
    r.Review_DateTime,
    r.Is_Anonymous
FROM review r
JOIN "user" u ON r.UserID = u.UserID
JOIN company c ON r.CompanyID = c.CompanyID;

-- 8. Simple Ratings
DROP VIEW IF EXISTS view_company_ratings;
CREATE VIEW view_company_ratings AS
SELECT Rating, CompanyID FROM review;]]></console>
