<BorderPane fx:id="appBorderPane" focusTraversable="true" minHeight="0.0" minWidth="0.0" prefHeight="650.0" prefWidth="1100.0" stylesheets="@../../../css/mainStylesheet.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.socketprogramming.atestat.MainController">
   <top>
      <HBox fx:id="navbarHBox" alignment="CENTER" maxHeight="68.0" minHeight="68.0" minWidth="1100.0" prefHeight="68.0" prefWidth="1100.0" spacing="20.0" style="-fx-background-color: #383838;" stylesheets="@../../../css/mainStylesheet.css" BorderPane.alignment="CENTER">
         <children>
            <Button id="backButton" fx:id="backButton" mnemonicParsing="false" onAction="#goBack" prefHeight="24.0" prefWidth="26.0" text="&lt;">
               <font>
                  <Font size="21.0" />
               </font></Button>
            <ComboBox fx:id="servicesComboBox" maxWidth="879.0" prefHeight="35.0" prefWidth="610.0" promptText="What service are you looking for today?" HBox.hgrow="SOMETIMES" />
            <Button id="loginButton" fx:id="userProfileButton" mnemonicParsing="false" prefHeight="54.0" prefWidth="326.0" text="User Profile" HBox.hgrow="SOMETIMES" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>

   <bottom>
      <VBox alignment="CENTER" maxHeight="-Infinity" minHeight="50.0" minWidth="1100.0" mouseTransparent="true" prefHeight="50.0" prefWidth="1100.0" style="-fx-background-color: #383838; -fx-border-color: #555555 transparent #555555 transparent; -fx-border-width: 2px 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="© Biznis Entertainment" textAlignment="CENTER" />
            <Text fill="#aeaeae" strokeType="OUTSIDE" strokeWidth="0.0" text="All rights reserved." textAlignment="CENTER">
               <VBox.margin>
                  <Insets top="2.0" />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
   </bottom>
   <center>
      <VBox alignment="CENTER" prefHeight="0.0" prefWidth="0.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="homeIconImageView" fitHeight="197.0" fitWidth="389.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../photos/homeMain.png" />
               </image>
               <viewport>
                  <Rectangle2D />
               </viewport>
            </ImageView>
            <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="59.0" prefWidth="1099.0" text="Hello there! Ran into some problems?" textAlignment="CENTER">
               <font>
                  <Font name="Candara" size="20.0" />
               </font></Label>
            <Label text=" No need to worry. Check what services we put at your disposal.">
               <font>
                  <Font name="Candara" size="20.0" />
               </font>
            </Label>
