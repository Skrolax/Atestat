<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="reviewItemContainer" fx:id="reviewItemContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="120.0" minWidth="1000.0" prefWidth="1000.0" spacing="10.0" stylesheets="@../../../css/reviewContainerStylesheet.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.socketprogramming.atestat.ReviewContainerController">
   <children>
      <HBox id="headerHBox" fx:id="headerHBox" alignment="CENTER_LEFT" maxHeight="100.0" maxWidth="1.7976931348623157E308" prefHeight="60.0" spacing="15.0">
         <children>
            <ImageView id="userImageView" fx:id="userImageView" fitHeight="50.0" fitWidth="1.0" pickOnBounds="true" preserveRatio="true" />
            <Label id="usernameLabel" fx:id="usernameLabel" prefHeight="30.0" prefWidth="602.0" text="Username: " />
            <HBox alignment="CENTER_RIGHT" prefHeight="57.0" prefWidth="184.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label id="ratingLabel" fx:id="ratingLabel" text="Rating: " />
               </children>
            </HBox>
         </children>
      </HBox>
      <VBox id="contentVBox" fx:id="contentVBox" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
