            <Label id="reviewTextLabel" fx:id="reviewTextLabel" alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefWidth="968.0" text="Review content goes here..." wrapText="true" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <HBox id="footerHBox" fx:id="footerHBox" alignment="CENTER_RIGHT" prefHeight="25.0">
         <children>
            <Label id="reviewDateLabel" fx:id="reviewDateLabel" text="Review Date: " />
         </children>
      </HBox>
   </children>
</VBox>
