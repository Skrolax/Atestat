<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox id="companyPageVBox" fx:id="companyPageVBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="500.0" minWidth="1000.0" prefHeight="0.0" prefWidth="0.0" stylesheets="@../../../css/companyAndUserPageStylesheet.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.socketprogramming.atestat.CompanyPageController">
   <children>
      <Label fx:id="companyNameLabel" alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="1000.0" style="-fx-background-color: #121212; -fx-border-width: 2px 0 0 0; -fx-border-color: #555555 transparent transparent transparent;" text=" Company Name" textAlignment="CENTER" textFill="WHITE" VBox.vgrow="ALWAYS">
         <font>
            <Font name="Candara Bold" size="21.0" />
         </font>
      </Label>
      <HBox id="companyContainerHBox" fx:id="companyContainerHBox" alignment="CENTER" prefHeight="0.0" prefWidth="1000.0" spacing="10.0" VBox.vgrow="NEVER">
         <children>
            <VBox id="leftCompanyContainerVBox" fx:id="leftCompanyContainerVBox" alignment="CENTER" prefHeight="298.0" prefWidth="383.0" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView id="leftCompanyContainerImageView" fx:id="leftCompanyContainerImageView" fitHeight="260.0" fitWidth="330.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../photos/defaulticonmouse.jpg" />
                     </image>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin></ImageView>
                  <Label id="leftContainerRatingLabel" fx:id="leftContainerRatingLabel" alignment="CENTER" prefHeight="18.0" prefWidth="262.0" text="TOTAL RATING:" textAlignment="CENTER" textFill="WHITE" />
               </children>
               <HBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </HBox.margin>
            </VBox>
            <HBox fx:id="rightCompanyContainerHBox" prefHeight="214.0" prefWidth="746.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" prefHeight="318.0" prefWidth="531.0">
                     <children>
                        <Label fx:id="addressLabel" prefHeight="38.0" prefWidth="388.0" text=" Adress: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="Calisto MT" size="14.0" />
                           </font></Label>
                        <Hyperlink fx:id="websiteHyperlink" prefHeight="38.0" prefWidth="388.0" text="Website: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Hyperlink>
                        <Label fx:id="foundedDateLabel" prefHeight="38.0" prefWidth="388.0" text=" Company Founded Date: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                     </children>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="214.0" prefWidth="545.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="businessEmailLabel" prefHeight="38.0" prefWidth="388.0" text=" Business Email: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                        <Label fx:id="businessPhoneLabel" prefHeight="38.0" prefWidth="388.0" text=" Business Phone Number: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                        <Label fx:id="customerEmailLabel" prefHeight="38.0" prefWidth="388.0" text=" Customer Service Email: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                        <Label fx:id="customerPhoneLabel" prefHeight="38.0" prefWidth="388.0" text=" Customer Service Phone Number: " textFill="WHITE" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                     </children>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </children></HBox>
      <HBox id="reviewLabel" fx:id="reviewTitleHBox" alignment="CENTER" maxHeight="28.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="NEVER">
         <children>
            <Label fx:id="reviewTitleLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="29.0" prefWidth="97.0" text="Reviews" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Candara Bold" size="21.0" />
               </font>
            </Label>
            <Button id="addReviewButton" fx:id="addReviewButton" mnemonicParsing="false" onAction="#addReview" prefHeight="28.0" prefWidth="82.0" text="(add review)" textFill="WHITE">
               <font>
                  <Font size="11.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <ScrollPane id="companyReviewScrollPane" fx:id="companyReviewScrollPane" fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="1000.0" pannable="true" prefHeight="278.0" prefWidth="1000.0" VBox.vgrow="ALWAYS">
         <content>
            <VBox id="companyReviewVBox" fx:id="companyReviewVBox" alignment="TOP_CENTER" focusTraversable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="1000.0" prefWidth="1038.0" spacing="10.0">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding></VBox>
         </content>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </ScrollPane>
   </children>
</VBox>
